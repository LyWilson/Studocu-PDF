{
  "manifest_version": 3,
  "name": "Studocu PDF Combiner",
  "description": "Auto-scroll Studocu pages, download BgX images, and combine them into a PDF.",
  "version": "1.0.0",
  "permissions": ["activeTab", "downloads", "storage", "scripting", "tabs"],
  "host_permissions": ["https://*.studocu.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Studocu PDF",
    "default_popup": "popup.html"
  }
}
